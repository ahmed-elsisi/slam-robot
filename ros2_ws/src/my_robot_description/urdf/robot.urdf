




<?xml version="1.0"?>
<robot name="slam_robot">

  <!-- ========================= -->
  <!-- Materials -->
  <!-- ========================= -->
  <material name="black">
    <color rgba="0.1 0.1 0.1 1.0"/>
  </material>

  <material name="blue">
    <color rgba="0.1 0.3 0.8 1.0"/>
  </material>

  <material name="gray">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <material name="red">
    <color rgba="0.8 0.1 0.1 1.0"/>
  </material>

  <!-- ========================= -->
  <!-- Base Footprint -->
  <!-- ========================= -->
  <link name="base_footprint"/>

  <!-- ========================= -->
  <!-- Base Link -->
  <!-- base_link is at the center of the chassis body -->
  <!-- chassis size = 0.38 x 0.17 x 0.12 -->
  <!-- ground clearance = 0.051 -->
  <!-- base_link height from ground = 0.051 + 0.12/2 = 0.111 -->
  <!-- ========================= -->
  <joint name="base_footprint_to_base_link" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0.111" rpy="0 0 0"/>
  </joint>

  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.17 0.12"/>
      </geometry>
      <material name="blue"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.38 0.17 0.12"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="4.0"/>
      <inertia
        ixx="0.020"
        ixy="0.0"
        ixz="0.0"
        iyy="0.050"
        iyz="0.0"
        izz="0.060"/>
    </inertial>
  </link>

  <!-- ========================= -->
  <!-- LiDAR -->
  <!-- LiDAR center height from ground = 0.238 -->
  <!-- base_link height from ground = 0.111 -->
  <!-- relative lidar z = 0.238 - 0.111 = 0.127 -->
  <!-- x offset = +0.01 -->
  <!-- y offset assumed = 0 -->
  <!-- ========================= -->
  <joint name="laser_joint" type="fixed">
    <parent link="base_link"/>
    <child link="laser"/>
    <origin xyz="0.01 0 0.127" rpy="0 0 0"/>
  </joint>

  <link name="laser">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
      <material name="red"/>
    </visual>

    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <cylinder radius="0.035" length="0.04"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.2"/>
      <inertia
        ixx="0.0001"
        ixy="0.0"
        ixz="0.0"
        iyy="0.0001"
        iyz="0.0"
        izz="0.0001"/>
    </inertial>
  </link>

  <!-- ========================= -->
  <!-- Wheels -->
  <!-- wheel diameter = 0.065 -->
  <!-- wheel radius = 0.0325 -->
  <!-- wheel width = 0.0253 -->
  <!-- left-right center distance = 0.215 => y = +/-0.1075 -->
  <!-- front-rear center distance = 0.213 => x = +/-0.1065 -->
  <!-- wheel center height from ground = 0.0325 -->
  <!-- relative wheel z = 0.0325 - 0.111 = -0.0785 -->
  <!-- wheel cylinders rotated so axle is along Y -->
  <!-- ========================= -->

  <!-- Front Left Wheel -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.1065 0.1075 -0.0785" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.0253"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.0253"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.00008"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00008"
        iyz="0.0"
        izz="0.00008"/>
    </inertial>
  </link>

  <!-- Front Right Wheel -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.1065 -0.1075 -0.0785" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.0253"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.0253"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.00008"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00008"
        iyz="0.0"
        izz="0.00008"/>
    </inertial>
  </link>

  <!-- Rear Left Wheel -->
  <joint name="rear_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_left_wheel"/>
    <origin xyz="-0.1065 0.1075 -0.0785" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rear_left_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.0253"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.0253"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.00008"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00008"
        iyz="0.0"
        izz="0.00008"/>
    </inertial>
  </link>

  <!-- Rear Right Wheel -->
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-0.1065 -0.1075 -0.0785" rpy="1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="rear_right_wheel">
    <visual>
      <geometry>
        <cylinder radius="0.0325" length="0.0253"/>
      </geometry>
      <material name="black"/>
    </visual>

    <collision>
      <geometry>
        <cylinder radius="0.0325" length="0.0253"/>
      </geometry>
    </collision>

    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="0.15"/>
      <inertia
        ixx="0.00008"
        ixy="0.0"
        ixz="0.0"
        iyy="0.00008"
        iyz="0.0"
        izz="0.00008"/>
    </inertial>
  </link>
</robot>



